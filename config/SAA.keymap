// layout_shift_kp_override.dtsi ではなく layout_shift.dtsi を include している。
// override 版は &kp を定義するが、Keymap Editor が #include の順序を並べ替えるため、
// behaviors.dtsi が後に読み込まれると &kp が素の key_press に戻ってしまう。
// &kp の上書きは下の behaviors ブロックで行う(ファイル後方なので必ず勝つ)。
#include <layout_shift.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/*
 * Layer map
 *
 *   0 DEF    : base layer (Windows host, host keyboard layout used as-is)
 *   1 MAC    : Mac mode overlay. Swaps the Ctrl / GUI(Cmd) modifier keys.
 *   2 WIN_US : indicator only (all &trans). Toggled together with the layout
 *              shift state by &us_mode, so the OLED can show that US-legend
 *              input on a JIS host is active.
 *   3 MAC_US : indicator only (all &trans). Activated by conditional_layers
 *              when MAC and WIN_US are both on, so the OLED shows both modes.
 *   4 FUNC .. 8 BT : ordinary momentary / toggled layers.
 *
 * The nice_oled layer widget prints the label of the highest active layer, so
 * while no other layer is held the OLED reads:
 *
 *   WIN     Windows mode, layout shift off
 *   MAC     Mac mode,     layout shift off
 *   WIN US  Windows mode, layout shift on  (type US legends on a JIS host)
 *   MAC US  Mac mode,     layout shift on
 */

#define DEF    0
#define MAC    1
#define WIN_US 2
#define MAC_US 3
#define FUNC   4
#define NUM    5
#define MOUSE  6
#define SCROLL 7
#define BT     8

&mt {
    flavor = "balanced";
    tapping-term-ms = <280>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
};

/ {
    behaviors {
        // layout_shift_kp_override.dtsi の内容をここに展開したもの。
        // ZMK コア用に素の key_press も残しておく。
        original_key_press: original_key_press {
            compatible = "zmk,behavior-key-press";
            #binding-cells = <1>;
            label = "KEY_PRESS";
        };

        // &kp をレイアウトシフト対応版に差し替える。
        kp: key_press {
            compatible = "zmk,behavior-layout-shift-key-press";
            #binding-cells = <1>;
            label = "LAYOUT_SHIFT_KEY_PRESS";
        };
    };

    macros {
        // US/JIS toggle: flips the zmk-layout-shift state (which is what
        // actually rewrites the key codes) and the WIN_US indicator layer
        // (which is only there so the state is visible on the OLED).

        us_mode: us_mode {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&tog_ls &tog WIN_US>;
            display-name = "US Mode";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        mac_us {
            if-layers = <MAC WIN_US>;
            then-layer = <MAC_US>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "Win";
            bindings = <
&kp ESCAPE  &kp Q     &kp W      &kp E     &kp R           &kp T           &kp Y          &kp U      &kp I      &kp O                 &kp P          &kp LEFT_BRACKET
&lt BT TAB  &kp A     &kp D      &kp S     &kp F           &kp G           &kp H          &kp J      &kp K      &kp L                 &kp SEMICOLON  &kp RIGHT_BRACKET
&kp LSHFT   &kp Z     &kp X      &kp C     &kp V           &kp GRAVE       &kp B          &kp N      &kp M      &kp COMMA             &kp PERIOD     &kp FSLH
&kp LCTRL   &kp LGUI  &kp LALT             &lt NUM DELETE  &lt FUNC SPACE  &kp BACKSPACE  &kp ENTER             &kp NON_US_BACKSLASH  &lt 4 SQT      &lt 6 LANGUAGE_5
&kp LEFT    &kp UP    &kp SPACE  &kp DOWN  &kp RIGHT                                      &kp HOME   &kp PG_UP  &kp ENTER             &kp PG_DN      &kp END
                                 &kp A                                                               &kp B
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        mac_layer {
            label = "Mac";
            bindings = <
&trans        &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans        &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans        &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&mt LGUI ESC  &kp LCTL  &trans          &trans  &trans  &trans  &trans          &trans  &trans  &trans
&trans        &trans    &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
                                &trans                                  &trans
            >;
        };

        win_us_layer {
            label = "Win US";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans          &trans  &trans  &trans  &trans          &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
                        &trans                                  &trans
            >;
        };

        mac_us_layer {
            label = "Mac US";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans          &trans  &trans  &trans  &trans          &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
                        &trans                                  &trans
            >;
        };

        function_layer {
            label = "Fnc";
            bindings = <
&kp ESCAPE  &kp F1    &kp F3     &kp F2    &kp F4     &kp F5    &kp F6  &kp F7    &kp F8     &kp F9     &kp F10    &trans
&us_mode    &kp F11   &trans     &kp F12   &trans     &tog MAC  &trans  &trans    &trans     &trans     &trans     &trans
&trans      &kp BKSP  &kp DEL    &trans    &trans     &trans    &trans  &trans    &trans     &trans     &trans     &trans
&trans      &trans    &kp LALT             &trans     &trans    &trans  &trans               &trans     &trans     &trans
&kp LEFT    &kp UP    &kp SPACE  &kp DOWN  &kp RIGHT                    &kp HOME  &kp PG_UP  &kp ENTER  &kp PG_DN  &kp END
                                 &kp A                                            &kp B
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        num_layer {
            label = "Num";
            bindings = <
&kp CAPS         &kp N1         &kp N2     &kp N3    &kp N4     &kp N5     &kp N6     &kp N7     &kp N8     &kp N9     &kp N0     &trans
&trans           &trans         &trans     &trans    &trans     &trans     &kp MINUS  &kp EQUAL  &kp LBKT   &kp RBKT   &kp BSLH   &trans
&mt LSHFT SPACE  &kp BACKSPACE  &kp DEL    &trans    &trans     &trans     &trans     &kp FSLH   &kp SEMI   &kp SQT    &trans     &trans
&trans           &kp ENTER      &kp ENTER            &kp ENTER  &kp ENTER  &kp ENTER  &kp ENTER             &trans     &trans     &trans
&kp LEFT         &kp UP         &kp SPACE  &kp DOWN  &kp RIGHT                        &kp HOME   &kp PG_UP  &kp ENTER  &kp PG_DN  &kp END
                                           &kp A                                                 &kp B
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        mouse_layer {
            label = "Mouse";
            bindings = <
&trans    &trans  &trans     &trans    &trans     &trans  &trans    &trans    &trans     &trans     &trans     &trans
&trans    &trans  &trans     &trans    &trans     &trans  &trans    &mkp MB1  &mkp MB3   &mkp MB2   &trans     &trans
&trans    &trans  &trans     &trans    &trans     &trans  &trans    &trans    &trans     &trans     &trans     &trans
&trans    &trans  &trans               &trans     &trans  &mkp MB4  &mkp MB5             &trans     &trans     &trans
&kp LEFT  &kp UP  &kp SPACE  &kp DOWN  &kp RIGHT                    &kp HOME  &kp PG_UP  &kp ENTER  &kp PG_DN  &kp END
                             &kp A                                            &kp B
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        scroll_layer {
            label = "Scr";
            bindings = <
&trans    &trans  &trans     &trans    &trans     &trans  &trans    &trans    &trans     &trans     &trans     &trans
&trans    &trans  &trans     &trans    &trans     &trans  &trans    &mkp MB1  &mkp MB3   &mkp MB2   &trans     &trans
&trans    &trans  &trans     &trans    &trans     &trans  &trans    &trans    &trans     &trans     &trans     &trans
&trans    &trans  &trans               &trans     &trans  &mkp MB4  &mkp MB5             &trans     &trans     &trans
&kp LEFT  &kp UP  &kp SPACE  &kp DOWN  &kp RIGHT                    &kp HOME  &kp PG_UP  &kp ENTER  &kp PG_DN  &kp END
                             &kp A                                            &kp B
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        bt_layer {
            label = "BT";
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR_ALL  &trans    &trans     &trans     &trans     &trans
&trans      &trans        &trans        &trans        &trans        &trans        &trans          &trans    &trans     &trans     &trans     &trans
&trans      &trans        &trans        &us_mode      &trans        &trans        &trans          &trans    &trans     &trans     &trans     &trans
&trans      &trans        &trans                      &trans        &trans        &trans          &trans               &trans     &trans     &trans
&kp LEFT    &kp UP        &kp SPACE     &kp DOWN      &kp RIGHT                                   &kp HOME  &kp PG_UP  &kp ENTER  &kp PG_DN  &kp END
                                        &kp A                                                               &kp B
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
